<html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <title>เข้าสู่ระบบ / สมัครสมาชิก</title>
  <style>
    body {
      font-family: 'Kanit', sans-serif;
      background: #f0f0f0;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 80px;
    }

    h2 { color: #333; }

    input {
      padding: 10px;
      font-size: 16px;
      margin: 5px;
      width: 250px;
    }

    button {
      padding: 10px 20px;
      margin: 10px;
      font-size: 16px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 10px;
      cursor: pointer;
    }

    button:hover {
      background-color: #0056b3;
    }

    .error {
      color: red;
      margin-top: 10px;
    }

    .form-box {
      display: none;
      flex-direction: column;
      align-items: center;
    }

    .nav-buttons {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <h2>กรุณาเลือก</h2>
  <div class="nav-buttons">
    <button onclick="showForm('login')">เข้าสู่ระบบ</button>
    <button onclick="showForm('register')">สมัครสมาชิก</button>
  </div>

  <div id="loginForm" class="form-box">
    <input type="text" id="loginUser" placeholder="ชื่อผู้ใช้">
    <input type="password" id="loginPass" placeholder="รหัสผ่าน">
    <button onclick="login()">เข้าสู่ระบบ</button>
    <div class="error" id="loginError"></div>
  </div>

  <div id="registerForm" class="form-box">
    <input type="text" id="regUser" placeholder="ตั้งชื่อผู้ใช้">
    <input type="password" id="regPass" placeholder="ตั้งรหัสผ่าน">
    <button onclick="register()">สมัครสมาชิก</button>
    <div class="error" id="regError"></div>
  </div>

  <script>
    function showForm(type) {
      document.getElementById("loginForm").style.display = (type === "login") ? "flex" : "none";
      document.getElementById("registerForm").style.display = (type === "register") ? "flex" : "none";
      document.getElementById("loginError").innerText = "";
      document.getElementById("regError").innerText = "";
    }

    function register() {
      const user = document.getElementById("regUser").value;
      const pass = document.getElementById("regPass").value;

      if (!user || !pass) {
        document.getElementById("regError").innerText = "กรุณากรอกข้อมูลให้ครบ";
        return;
      }

      if (localStorage.getItem("user")) {
        document.getElementById("regError").innerText = "มีผู้ใช้นี้อยู่แล้ว กรุณาเข้าสู่ระบบ";
      } else {
        localStorage.setItem("user", user);
        localStorage.setItem("pass", pass);
        alert("สมัครสมาชิกสำเร็จ! กำลังเข้าสู่ระบบ...");
        window.location.href = "wheel.html"; // ไปหน้าสุ่มทันที
      }
    }

    function login() {
      const user = document.getElementById("loginUser").value;
      const pass = document.getElementById("loginPass").value;
      const savedUser = localStorage.getItem("user");
      const savedPass = localStorage.getItem("pass");

      if (user === savedUser && pass === savedPass) {
        alert("เข้าสู่ระบบสำเร็จ!");
        window.location.href = "wheel.html"; // ไปหน้าสุ่มทันที
      } else {
        document.getElementById("loginError").innerText = "ชื่อผู้ใช้หรือรหัสผ่านไม่ถูกต้อง";
      }
    }
  </script>
</body>
</html>
